# Copy to .env and edit. The released scripts read these with os.environ / Sys.getenv.
PROJECT_ROOT=/path/to/your/copy/of/ST_Data          # was /home/ST_Data
LEGACY_DATA_ROOT=/path/to/legacy/Data               # was /home/Data  (older spatial objects)
HOME_ROOT=/path/to/home                             # was /home/wr   (conda, R libraries)

# common.py is bundled in src; leave empty unless overriding with an author version
AUTHOR_COMMON_DIR=
# External author R helpers remain required
SCISSOR_HELPER_R=/path/to/Scissor5.R
SCHARD_FUNCTIONS_R=/path/to/schard/R/functions.R
SCHARD_H5AD_R=/path/to/schard/R/h5ad_util.R
BULK_METADATA_ROOT=/path/to/bulk/metadata
# Optional clinical working-tree override
ST_WD=/path/to/clinical/worktree
